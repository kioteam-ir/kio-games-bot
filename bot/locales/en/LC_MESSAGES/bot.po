msgid "start"
msgstr ""
"🎮 Welcome to Kio Games!\n"
"Here you can play various two-player games with your friends and compete together. 😎\n"
"To get started:\n"
"Tap the button below.\n"
"Choose your friend or group.\n"
"⚠️ Note: Games cannot be played inside the bot's private chat; you must play through a chat with your friend or a group.\n"
"Well, are you ready? Let's go! 🚀"

msgid "start-game-button"
msgstr "🎮 Start Game"

msgid "play-again-button"
msgstr "🎮 Play Again"

msgid "support-button"
msgstr "💬 Support"

msgid "game-guide-button"
msgstr "📖 Game Guides"

msgid "support-text"
msgstr ""
"💬 <b>Kio Games Support</b>\n\n"
"For support, bug reports, or suggestions, please contact:\n"
"👉 @yas3in_official"

msgid "support-direct-button"
msgstr "💬 Message Support"

msgid "game-guide-text"
msgstr ""
"📖 <b>Which game tutorial do you want?</b>\n\n"
"Select a game below to watch the tutorial:"

msgid "xo-tutorial-button"
msgstr "🎮 XO Tutorial"

msgid "create-game-text"
msgstr "🕹 Ready? Then create a game 🕹"

msgid "create-game-button"
msgstr "🕹 Create Game 🕹"

msgid "you-are-banned-title"
msgstr "You are banned from our bot!"

msgid "you-are-banned-text"
msgstr "You are banned from playing in our bot."

msgid "waiting-for-player"
msgstr "⏳ Waiting for a player... ⏳"

msgid "i-play"
msgstr "I'll play 🙋"

msgid "cannot-play-with-yourself"
msgstr "You cannot play with yourself 😅"

msgid "not-your-game"
msgstr "❌ You are not in this game ❌"

msgid "not-your-turn"
msgstr "❌ It's not your turn ❌"

msgid "column-full"
msgstr "❌ This column is full ❌"

msgid "player-game-stats"
msgstr "📊 Player Stats 📊\n\n🕹 All games [{all_games}] 🕹\n🥇 Wins [{wins}] 🥇\n🥈 Losses [{losses}] 🥈\n🟰 Draws [{draws}] 🟰"

msgid "game-in-progress-text"
msgstr "🕹 Turn: {name} [{color}]ㅤ                       ㅤㅤㅤㅤㅤㅤㅤㅤㅤㅤ\n🕹 Make your move 🕹"

msgid "game-ended-text"
msgstr "🏆 Winner of the game: {winner}\n⚔ Total matches played between you two: [{total} {game}]\n1️⃣ {p1_name}: {p1_wins}\n2️⃣ {p2_name}: {p2_wins}\n🟰 Draws: {draws}"

msgid "game-is-draw-text"
msgstr "No winner 💢"

msgid "game"
msgstr "Game"

msgid "play-with-cool-people-button"
msgstr "😎 Play with cool people 😎"

msgid "play-with-cool-people-text"
msgstr "😬🎮 Nobody wanted to play 😬\n\nSend it to the cool ones, they won't say no 😒"

msgid "game-stopped"
msgstr "🎮 The game was stopped due to inactivity 🎮"

msgid "already-game-creator"
msgstr "You created this game — wait for someone else to join 😅"

msgid "game-already-started"
msgstr "This game already has two players ❌"

msgid "game-already-ended"
msgstr "This game is already over ❌"

msgid "game-expired"
msgstr "This game is no longer available ⏳"

msgid "rate-limit-exceeded"
msgstr "Too many requests — please wait a moment ⏳"

msgid "lang-changed"
msgstr "Language changed successfully ✅"

