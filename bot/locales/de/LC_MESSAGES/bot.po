msgid "start"
msgstr ""
"🎮 Willkommen bei Kio Games!\n"
"Hier kannst du verschiedene Zwei-Spieler-Spiele mit deinen Freunden spielen und gegeneinander antreten. 😎\n"
"Um zu starten:\n"
"Klicke auf den Button unten.\n"
"Wähle deinen Freund oder deine Gruppe aus.\n"
"⚠️ Hinweis: Spiele können nicht im privaten Chat mit dem Bot gespielt werden; du musst über einen Chat mit deinem Freund oder in einer Gruppe spielen.\n"
"Bist du bereit? Los geht's! 🚀"

msgid "start-game-button"
msgstr "🎮 Spiel starten"

msgid "play-again-button"
msgstr "🎮 Nochmal spielen"

msgid "support-button"
msgstr "💬 Support"

msgid "game-guide-button"
msgstr "📖 Spielanleitungen"

msgid "support-text"
msgstr ""
"💬 <b>Kio Games Support</b>\n\n"
"Für Support, Fehlerberichte oder Vorschläge kontaktieren Sie bitte:\n"
"👉 @yas3in_official"

msgid "support-direct-button"
msgstr "💬 Support kontaktieren"

msgid "game-guide-text"
msgstr ""
"📖 <b>Für welches Spiel möchtest du eine Anleitung?</b>\n\n"
"Wähle unten ein Spiel aus, um das Tutorial anzusehen:"

msgid "xo-tutorial-button"
msgstr "🎮 XO Anleitung"

msgid "create-game-text"
msgstr "🕹 Bereit? Dann erstelle ein Spiel 🕹"

msgid "create-game-button"
msgstr "🕹 Spiel erstellen 🕹"

msgid "you-are-banned-title"
msgstr "Du bist in unserem Bot gesperrt!"

msgid "you-are-banned-text"
msgstr "Du darfst in unserem Bot nicht spielen."

msgid "waiting-for-player"
msgstr "⏳ Warte auf einen Spieler... ⏳"

msgid "i-play"
msgstr "Ich spiele mit 🙋"

msgid "cannot-play-with-yourself"
msgstr "Du kannst nicht gegen dich selbst spielen 😅"

msgid "not-your-game"
msgstr "❌ Du bist nicht in diesem Spiel ❌"

msgid "not-your-turn"
msgstr "❌ Du bist nicht dran ❌"

msgid "column-full"
msgstr "❌ Diese Spalte ist voll ❌"

msgid "player-game-stats"
msgstr "📊 Spielerstatistik 📊\n\n🕹 Alle Spiele [{all_games}] 🕹\n🥇 Siege [{wins}] 🥇\n🥈 Niederlagen [{losses}] 🥈\n🟰 Unentschieden [{draws}] 🟰"

msgid "game-in-progress-text"
msgstr "🕹 Zug: {name} [{color}]ㅤ                       ㅤㅤㅤㅤㅤㅤㅤㅤㅤㅤ\n🕹 Mach deinen Zug 🕹"

msgid "game-ended-text"
msgstr "🏆 Gewinner: {winner}\n⚔ Gesamtspiele zwischen euch: [{total} {game}]\n1️⃣ {p1_name}: {p1_wins}\n2️⃣ {p2_name}: {p2_wins}\n🟰 Unentschieden: {draws}"

msgid "game-is-draw-text"
msgstr "Kein Gewinner 💢"

msgid "game"
msgstr "Spiel"

msgid "play-with-cool-people-button"
msgstr "😎 Mit coolen Leuten spielen 😎"

msgid "play-with-cool-people-text"
msgstr "😬🎮 Niemand wollte spielen 😬\n\nSchick es den Coolen — die sagen nicht nein 😒"

msgid "game-stopped"
msgstr "🎮 Das Spiel wurde wegen Inaktivität beendet 🎮"

msgid "already-game-creator"
msgstr "Du hast dieses Spiel erstellt — warte auf einen Mitspieler 😅"

msgid "game-already-started"
msgstr "❌ Dieses Spiel hat bereits zwei Spieler ❌"

msgid "game-already-ended"
msgstr "❌ Dieses Spiel ist bereits vorbei ❌"

msgid "game-expired"
msgstr "⏳ Dieses Spiel ist nicht mehr verfügbar ⏳"

msgid "lang-changed"
msgstr "Sprache erfolgreich geändert ✅"

msgid "change-your-lang"
msgstr "✅ Sprache ändern ✅"

msgid "change-your-lang-text"
msgstr "✅ Klicke, um die Sprache zu ändern ✅"

msgid "join-first"
msgstr "Nachdem du den Sponsor-Kanälen beigetreten bist, klicke erneut auf diesen Button, um dem Spiel beizutreten."

msgid "sponsors-updated"
msgstr "Sponsoren aktualisiert: {count}"

msgid "choose-number-of-mines"
msgstr "💣 Choose the number of mines 💣"

msgid "cell-already-revealed"
msgstr "❌ This cell is already revealed ❌"

msgid "invalid-move"
msgstr "❌ Invalid move ❌"

msgid "mine-game-in-progress-text"
msgstr "🕹 Turn: {name} [{color}]\n💣 {p1_name}: {p1_mines}/{target} | {p2_name}: {p2_mines}/{target}"

msgid "mine-game-score-line"
msgstr "💣 Mines found: {p1_name} {p1_mines}/{target} | {p2_name} {p2_mines}/{target}"
