msgid ""
msgstr ""
"Project-Id-Version: kio-games-bot\n"
"Language: he\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "start"
msgstr ""
"🎮 ברוכים הבאים ל-Kio Games!\n"
"כאן תוכלו לשחק במגוון משחקים לשני שחקנים עם חברים ולהתחרות יחד. 😎\n"
"כדי להתחיל:\n"
"לחצו על הכפתור למטה.\n"
"בחרו את החבר או הקבוצה שלכם.\n"
"⚠️ שימו לב: לא ניתן לשחק בתוך הצ'אט הפרטי עם הבוט; יש לשחק דרך צ'אט עם חבר או בקבוצה.\n"
"ובכן, מוכנים? קדימה! 🚀"

msgid "start-game-button"
msgstr "🎮 התחל משחק"

msgid "play-again-button"
msgstr "🎮 שחק שוב"

msgid "support-button"
msgstr "💬 תמיכה"

msgid "game-guide-button"
msgstr "📖 מדריכי משחק"

msgid "support-text"
msgstr ""
"💬 <b>תמיכת Kio Games</b>\n\n"
"לתמיכה, דיווח על תקלות או הצעות, צרו קשר:\n"
"👉 @yas3in_official"

msgid "support-direct-button"
msgstr "💬 פנה לתמיכה"

msgid "game-guide-text"
msgstr ""
"📖 <b>מדריך לאיזה משחק תרצה?</b>\n\n"
"בחר משחק למטה כדי לצפות במדריך:"

msgid "xo-tutorial-button"
msgstr "🎮 מדריך XO"

msgid "create-game-text"
msgstr "🕹 מוכנים? צרו משחק 🕹"

msgid "create-game-button"
msgstr "🕹 צור משחק 🕹"

msgid "you-are-banned-title"
msgstr "נחסמתם מהבוט שלנו!"

msgid "you-are-banned-text"
msgstr "אינכם רשאים לשחק בבוט שלנו."

msgid "waiting-for-player"
msgstr "⏳ ממתינים לשחקן... ⏳"

msgid "i-play"
msgstr "אני משחק 🙋"

msgid "cannot-play-with-yourself"
msgstr "אי אפשר לשחק נגד עצמך 😅"

msgid "not-your-game"
msgstr "❌ אתה לא במשחק הזה ❌"

msgid "not-your-turn"
msgstr "❌ זה לא התור שלך ❌"

msgid "column-full"
msgstr "❌ העמודה מלאה ❌"

msgid "player-game-stats"
msgstr "📊 סטטיסטיקות שחקן 📊\n\n🕹 כל המשחקים [{all_games}] 🕹\n🥇 ניצחונות [{wins}] 🥇\n🥈 הפסדים [{losses}] 🥈\n🟰 תיקו [{draws}] 🟰"

msgid "game-in-progress-text"
msgstr "🕹 תור: {name} [{color}]ㅤ                       ㅤㅤㅤㅤㅤㅤㅤㅤㅤㅤ\n🕹 בצע מהלך 🕹"

msgid "game-ended-text"
msgstr "🏆 המנצח: {winner}\n⚔ סך המשחקים ביניכם: [{total} {game}]\n1️⃣ {p1_name}: {p1_wins}\n2️⃣ {p2_name}: {p2_wins}\n🟰 תיקו: {draws}"

msgid "game-is-draw-text"
msgstr "תיקו 💢"

msgid "game"
msgstr "משחק"

msgid "play-with-cool-people-button"
msgstr "😎 שחק עם אנשים מגניבים 😎"

msgid "play-with-cool-people-text"
msgstr "😬🎮 אף אחד לא רצה לשחק 😬\n\nשלח לאנשים המגניבים — הם לא יסרבו 😒"

msgid "game-stopped"
msgstr "🎮 המשחק הופסק בגלל חוסר פעילות 🎮"

msgid "already-game-creator"
msgstr "יצרת את המשחק הזה — המתן לשחקן נוסף 😅"

msgid "game-already-started"
msgstr "❌ למשחק הזה כבר יש שני שחקנים ❌"

msgid "game-already-ended"
msgstr "❌ המשחק הזה כבר נגמר ❌"

msgid "game-expired"
msgstr "⏳ המשחק הזה כבר לא זמין ⏳"

msgid "lang-changed"
msgstr "השפה שונתה בהצלחה ✅"

msgid "change-your-lang"
msgstr "✅ שנה שפה ✅"

msgid "change-your-lang-text"
msgstr "✅ לחץ כדי לשנות שפה ✅"

msgid "join-first"
msgstr "לאחר ההצטרפות לערוצי הספונסרים, לחץ שוב על כפתור זה כדי להיכנס למשחק."

msgid "sponsors-updated"
msgstr "רשימת הספונסרים עודכנה: {count}"

msgid "choose-number-of-mines"
msgstr "💣 Choose the number of mines 💣"

msgid "cell-already-revealed"
msgstr "❌ This cell is already revealed ❌"

msgid "invalid-move"
msgstr "❌ Invalid move ❌"

msgid "mine-game-in-progress-text"
msgstr "🕹 Turn: {name} [{color}]\n💣 {p1_name}: {p1_mines}/{target} | {p2_name}: {p2_mines}/{target}"

msgid "mine-game-score-line"
msgstr "💣 Mines found: {p1_name} {p1_mines}/{target} | {p2_name} {p2_mines}/{target}"
