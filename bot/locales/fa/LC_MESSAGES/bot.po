msgid ""
msgstr ""
"Project-Id-Version: kio-games-bot\n"
"Language: fa\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "start"
msgstr ""
"🎮 به کایوگیم خوش اومدی!\n"
"اینجا میتونی با دوستات بازی های دونفره مختلف انجام بدی و با هم رقابت کنید. 😎\n"
"برای شروع:\n"
"روی دکمه زیر بزن.\n"
"دوستت یا گروه موردنظرت رو انتخاب کن.\n"
"⚠️ توجه: بازی ها داخل چت خصوصی ربات اجرا نمیشن؛ برای بازی باید از طریق چت با دوستت یا گروه اقدام کنی.\n"
"خب، آماده ای؟ بزن بریم! 🚀"

msgid "start-game-button"
msgstr "🎮 شروع بازی"

msgid "play-again-button"
msgstr "🎮 بازی دوباره"

msgid "support-button"
msgstr "💬 ارتباط با پشتیبانی"

msgid "game-guide-button"
msgstr "📖 راهنمای بازی‌ها"

msgid "support-text"
msgstr ""
"💬 <b>ارتباط با پشتیبانی کایو گیم</b>\n\n"
"جهت ارتباط با پشتیبانی، گزارش مشکلات یا ارسال نظرات و پیشنهادات با آیدی زیر در ارتباط باشید:\n"
"👉 @yas3in_official"

msgid "support-direct-button"
msgstr "💬 پیام به پشتیبانی"

msgid "game-guide-text"
msgstr ""
"📖 <b>آموزش کدوم بازی رو میخوای؟</b>\n\n"
"برای مشاهده آموزش و یادگیری، روی دکمه بازی موردنظرت بزن:"

msgid "xo-tutorial-button"
msgstr "🎮 آموزش xo"

msgid "create-game-text"
msgstr "🕹 اوکیه؟ پس بزن ساخت بازی 🕹"

msgid "create-game-button"
msgstr "🕹 ساخت بازی 🕹"

msgid "you-are-banned-title"
msgstr "شما ربات ما مسدود شده‌اید!"

msgid "you-are-banned-text"
msgstr "شما از بازی کردن در ربات ما مسدود شده‌اید"

msgid "waiting-for-player"
msgstr "⏳ در انتظار بازیکن... ⏳"

msgid "i-play"
msgstr "بازی میکنم 🙋"

msgid "cannot-play-with-yourself"
msgstr "نمیتوانید با خودتان بازی کنید 😅"

msgid "not-your-game"
msgstr "❌ شما در این بازی نیستید ❌"

msgid "not-your-turn"
msgstr "❌ نوبت شما نیست ❌"

msgid "column-full"
msgstr "❌ ستون پر شده است ❌"

msgid "player-game-stats"
msgstr "📊 اطلاعات بازی کاربر 📊\n\n🕹 همه بازی‌ها [{all_games}] 🕹\n🥇 بردها [{wins}] 🥇\n🥈 باخت‌ها [{losses}] 🥈\n🟰 تساوی‌ها [{draws}] 🟰"

msgid "game-in-progress-text"
msgstr "🕹 نوبت : {name} [{color}]ㅤ                       ㅤㅤㅤㅤㅤㅤㅤㅤㅤㅤ\n🕹 بازی کنید 🕹"

msgid "game-ended-text"
msgstr "🏆 برنده بازی : {winner}\n⚔ نتایج کل مسابقات بین شما دو نفر: [{total} {game}]\n1️⃣ {p1_name} : {p1_wins}\n2️⃣ {p2_name} : {p2_wins}\n🟰 تساوی‌ها : {draws}"

msgid "game-is-draw-text"
msgstr "بدون برنده 💢"

msgid "game"
msgstr "بازی"

msgid "play-with-cool-people-button"
msgstr "😎 بازی با آدم باحالا 😎"

msgid "play-with-cool-people-text"
msgstr "😬🎮 هیچکسی مایل به بازی کردن نبود 😬\n\nپیش آدم باحالا بفرست اینا که نمیان بازی 😒"

msgid "game-stopped"
msgstr "🎮 بازی به دلیل وقفه زیاد، متوقف شد 🎮"

msgid "already-game-creator"
msgstr "این بازی رو خودت ساختی — منتظر نفر دوم بمون 😅"

msgid "game-already-started"
msgstr "❌ این بازی قبلاً دو بازیکن داره ❌"

msgid "game-already-ended"
msgstr "❌ این بازی تموم شده ❌"

msgid "game-expired"
msgstr "⏳ این بازی دیگه در دسترس نیست ⏳"

msgid "rate-limit-exceeded"
msgstr "⏳ درخواست‌های زیاد — لطفاً کمی صبر کن ⏳"

msgid "lang-changed"
msgstr "زبان با موفقیت تغییر کرد ✅"

msgid "change-your-lang"
msgstr "✅ تغییر زبان ✅"

msgid "change-your-lang-text"
msgstr "✅ برای تغییر زبان کلیک کنید ✅"

msgid "join-first"
msgstr "پس از عضویت در کانال های اسپانسر دوباره روی این دکمه کلیک کنید تا وارد بازی شوید."

msgid "sponsors-updated"
msgstr "لیست اسپانسرها به‌روزرسانی شد: {count}"

msgid "choose-number-of-mines"
msgstr "💣 تعداد مین‌ها را انتخاب کنید 💣"

msgid "cell-already-revealed"
msgstr "❌ این خانه قبلاً باز شده ❌"

msgid "invalid-move"
msgstr "❌ حرکت نامعتبر ❌"

msgid "mine-game-in-progress-text"
msgstr "🕹 نوبت: {name} [{color}]\n💣 {p1_name}: {p1_mines}/{target} | {p2_name}: {p2_mines}/{target}"

msgid "mine-game-score-line"
msgstr "💣 مین‌های پیدا شده: {p1_name} {p1_mines}/{target} | {p2_name} {p2_mines}/{target}"
