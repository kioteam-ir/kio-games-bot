msgid "start"
msgstr ""
"🎮 مرحباً بك في كايو جيم!\n"
"هنا يمكنك لعب ألعاب ثنائية مختلفة مع أصدقائك والتنافس معاً. 😎\n"
"للبدء:\n"
"اضغط على الزر أدناه.\n"
"اختر صديقك أو مجموعتك.\n"
"⚠️ ملاحظة: لا تعمل الألعاب داخل الدردشة الخاصة بالبوت؛ يجب أن تلعب عبر الدردشة مع صديقك أو في مجموعة.\n"
"حسناً، هل أنت مستعد؟ هيا بنا! 🚀"

msgid "start-game-button"
msgstr "🎮 ابدأ اللعبة"

msgid "play-again-button"
msgstr "🎮 العب مرة أخرى"

msgid "support-button"
msgstr "💬 الدعم الفني"

msgid "game-guide-button"
msgstr "📖 دليل الألعاب"

msgid "support-text"
msgstr ""
"💬 <b>دعم كايو جيم</b>\n\n"
"للدعم الفني أو الإبلاغ عن المشاكل أو الاقتراحات، يرجى التواصل مع:\n"
"👉 @yas3in_official"

msgid "support-direct-button"
msgstr "💬 مراسلة الدعم"

msgid "game-guide-text"
msgstr ""
"📖 <b>أي لعبة تريد شرحها؟</b>\n\n"
"اختر اللعبة أدناه لمشاهدة الشرح:"

msgid "xo-tutorial-button"
msgstr "🎮 شرح xo"

msgid "create-game-text"
msgstr "🕹 جاهز؟ أنشئ لعبة 🕹"

msgid "create-game-button"
msgstr "🕹 إنشاء لعبة 🕹"

msgid "you-are-banned-title"
msgstr "أنت محظور من بوتنا!"

msgid "you-are-banned-text"
msgstr "لا يُسمح لك باللعب في بوتنا."

msgid "waiting-for-player"
msgstr "⏳ في انتظار لاعب... ⏳"

msgid "i-play"
msgstr "سألعب 🙋"

msgid "cannot-play-with-yourself"
msgstr "لا يمكنك اللعب مع نفسك 😅"

msgid "not-your-game"
msgstr "❌ أنت لست في هذه اللعبة ❌"

msgid "not-your-turn"
msgstr "❌ ليس دورك ❌"

msgid "column-full"
msgstr "❌ هذا العمود ممتلئ ❌"

msgid "player-game-stats"
msgstr "📊 إحصائيات اللاعب 📊\n\n🕹 كل الألعاب [{all_games}] 🕹\n🥇 انتصارات [{wins}] 🥇\n🥈 خسائر [{losses}] 🥈\n🟰 تعادلات [{draws}] 🟰"

msgid "game-in-progress-text"
msgstr "🕹 الدور: {name} [{color}]ㅤ                       ㅤㅤㅤㅤㅤㅤㅤㅤㅤㅤ\n🕹 قم بحركتك 🕹"

msgid "game-ended-text"
msgstr "🏆 الفائز: {winner}\n⚔ إجمالي المباريات بينكما: [{total} {game}]\n1️⃣ {p1_name}: {p1_wins}\n2️⃣ {p2_name}: {p2_wins}\n🟰 تعادلات: {draws}"

msgid "game-is-draw-text"
msgstr "تعادل 💢"

msgid "game"
msgstr "لعبة"

msgid "play-with-cool-people-button"
msgstr "😎 العب مع أشخاص رائعين 😎"

msgid "play-with-cool-people-text"
msgstr "😬🎮 لم يرغب أحد باللعب 😬\n\nأرسلها للرائعين، لن يرفضوا 😒"

msgid "game-stopped"
msgstr "🎮 توقفت اللعبة بسبب عدم النشاط 🎮"

msgid "already-game-creator"
msgstr "أنت من أنشأ هذه اللعبة — انتظر لاعباً آخر 😅"

msgid "game-already-started"
msgstr "❌ هذه اللعبة لديها لاعبان بالفعل ❌"

msgid "game-already-ended"
msgstr "❌ هذه اللعبة انتهت بالفعل ❌"

msgid "game-expired"
msgstr "⏳ هذه اللعبة لم تعد متاحة ⏳"

msgid "lang-changed"
msgstr "تم تغيير اللغة بنجاح ✅"

msgid "change-your-lang"
msgstr "✅ تغيير اللغة ✅"

msgid "change-your-lang-text"
msgstr "✅ اضغط لتغيير اللغة ✅"

msgid "join-first"
msgstr "بعد الانضمام إلى قنوات الرعاة، اضغط على هذا الزر مرة أخرى للدخول إلى اللعبة."

msgid "sponsors-updated"
msgstr "تم تحديث الرعاة: {count}"

msgid "choose-number-of-mines"
msgstr "💣 Choose the number of mines 💣"

msgid "cell-already-revealed"
msgstr "❌ This cell is already revealed ❌"

msgid "invalid-move"
msgstr "❌ Invalid move ❌"

msgid "mine-game-in-progress-text"
msgstr "🕹 Turn: {name} [{color}]\n💣 {p1_name}: {p1_mines}/{target} | {p2_name}: {p2_mines}/{target}"

msgid "mine-game-score-line"
msgstr "💣 Mines found: {p1_name} {p1_mines}/{target} | {p2_name} {p2_mines}/{target}"
