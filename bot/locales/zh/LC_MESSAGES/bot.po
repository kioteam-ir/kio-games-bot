msgid ""
msgstr ""
"Project-Id-Version: kio-games-bot\n"
"Language: zh\n"
"Content-Type: text/plain; charset=UTF-8\n"

msgid "start"
msgstr ""
"🎮 欢迎来到 Kio Games！\n"
"在这里你可以和朋友一起玩各种双人游戏并互相切磋。 😎\n"
"开始步骤：\n"
"点击下方按钮。\n"
"选择你的好友或群组。\n"
"⚠️ 注意：游戏无法在机器人的私聊中运行；你必须在与好友的聊天或群组中发起游戏。\n"
"准备好了吗？开始吧！ 🚀"

msgid "start-game-button"
msgstr "🎮 开始游戏"

msgid "play-again-button"
msgstr "🎮 再玩一局"

msgid "support-button"
msgstr "💬 客服支持"

msgid "game-guide-button"
msgstr "📖 游戏指南"

msgid "support-text"
msgstr ""
"💬 <b>Kio Games 客服支持</b>\n\n"
"如有问题、Bug反馈或建议，请联系：\n"
"👉 @yas3in_official"

msgid "support-direct-button"
msgstr "💬 发消息给客服"

msgid "game-guide-text"
msgstr ""
"📖 <b>你想了解哪个游戏的玩法？</b>\n\n"
"请在下方选择游戏以查看教程："

msgid "xo-tutorial-button"
msgstr "🎮 XO 教学"

msgid "create-game-text"
msgstr "🕹 准备好了吗？创建游戏 🕹"

msgid "create-game-button"
msgstr "🕹 创建游戏 🕹"

msgid "you-are-banned-title"
msgstr "你已被封禁！"

msgid "you-are-banned-text"
msgstr "你已被禁止在本机器人中游戏。"

msgid "waiting-for-player"
msgstr "⏳ 等待玩家加入... ⏳"

msgid "i-play"
msgstr "我来玩 🙋"

msgid "cannot-play-with-yourself"
msgstr "你不能和自己对战 😅"

msgid "not-your-game"
msgstr "❌ 你不在这局游戏中 ❌"

msgid "not-your-turn"
msgstr "❌ 还没轮到你 ❌"

msgid "column-full"
msgstr "❌ 这一列已满 ❌"

msgid "player-game-stats"
msgstr "📊 玩家统计 📊\n\n🕹 总场次 [{all_games}] 🕹\n🥇 胜场 [{wins}] 🥇\n🥈 负场 [{losses}] 🥈\n🟰 平局 [{draws}] 🟰"

msgid "game-in-progress-text"
msgstr "🕹 轮到：{name} [{color}]ㅤ                       ㅤㅤㅤㅤㅤㅤㅤㅤㅤㅤ\n🕹 请落子 🕹"

msgid "game-ended-text"
msgstr "🏆 获胜者：{winner}\n⚔ 你们之间的总对局：[{total} {game}]\n1️⃣ {p1_name}：{p1_wins}\n2️⃣ {p2_name}：{p2_wins}\n🟰 平局：{draws}"

msgid "game-is-draw-text"
msgstr "平局 💢"

msgid "game"
msgstr "游戏"

msgid "play-with-cool-people-button"
msgstr "😎 和酷的人一起玩 😎"

msgid "play-with-cool-people-text"
msgstr "😬🎮 没人想玩 😬\n\n发给酷的朋友们，他们不会拒绝 😒"

msgid "game-stopped"
msgstr "🎮 由于长时间无操作，游戏已停止 🎮"

msgid "already-game-creator"
msgstr "这是你创建的游戏——请等待其他人加入 😅"

msgid "game-already-started"
msgstr "❌ 这局游戏已有两名玩家 ❌"

msgid "game-already-ended"
msgstr "❌ 这局游戏已经结束 ❌"

msgid "game-expired"
msgstr "⏳ 这局游戏已不可用 ⏳"

msgid "lang-changed"
msgstr "语言已成功更改 ✅"

msgid "change-your-lang"
msgstr "✅ 更改语言 ✅"

msgid "change-your-lang-text"
msgstr "✅ 点击更改语言 ✅"

msgid "join-first"
msgstr "加入赞助商频道后，再次点击此按钮即可进入游戏。"

msgid "sponsors-updated"
msgstr "赞助商已更新：{count}"

msgid "choose-number-of-mines"
msgstr "💣 Choose the number of mines 💣"

msgid "cell-already-revealed"
msgstr "❌ This cell is already revealed ❌"

msgid "invalid-move"
msgstr "❌ Invalid move ❌"

msgid "mine-game-in-progress-text"
msgstr "🕹 Turn: {name} [{color}]\n💣 {p1_name}: {p1_mines}/{target} | {p2_name}: {p2_mines}/{target}"

msgid "mine-game-score-line"
msgstr "💣 Mines found: {p1_name} {p1_mines}/{target} | {p2_name} {p2_mines}/{target}"
