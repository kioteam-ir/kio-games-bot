msgid "support-text"
msgstr ""
"💬 <b>د Kio Games ملاتړ</b>\n\n"
"د ملاتړ، ستونزو راپور ورکولو یا وړاندیزونو لپاره اړیکه ونیسئ:\n"
"👉 @yas3in_official"

msgid "support-direct-button"
