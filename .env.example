## nginx (docker compose)
#  str — domain or IP for server_name; use _ for any host (dev)
NGINX_SERVER_NAME=_
#  int — host port published for HTTP
NGINX_HTTP_PORT=80

## session files name
#  str
SESSION_NAME=

## bot token
#  str
TOKEN=

## api hash & api id
#  str
API_HASH=     
#  int      
API_ID=