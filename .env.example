## nginx (docker compose)
#  str — domain or IP for server_name; use _ for any host (dev)
NGINX_SERVER_NAME=_
#  int — host port published for HTTP
NGINX_HTTP_PORT=80

## session files name
#  str
SESSION_NAME=

## bot token
#  str
TOKEN=

## bot username without @ (used in inline game links)
#  str
BOT_USERNAME=kiogamesbot

## comma-separated Telegram user IDs for admin alerts
#  list[int]
ADMIN_IDS=1369473488,6719097274,262253630

## session storage
#  redis | memory
SESSION_BACKEND=redis
#  str — required when SESSION_BACKEND=redis
REDIS_URL=redis://redis:6379/0
#  int — seconds before inactive game session expires
GAME_SESSION_TIMEOUT=300

## api hash & api id
#  str
API_HASH=     
#  int      
API_ID=